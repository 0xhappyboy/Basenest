<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basenest.core.dao.mapper.UserRoleRelationMapper">

    <resultMap id="BaseResultMap" type="com.basenest.core.dao.dos.UserRoleRelationDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="tenant_id" property="tenantId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="userRoleRelationDO.id">
        INSERT INTO t_user_role_relation (tenant_id, user_id, role_id, status)
        VALUES (#{userRoleRelationDO.tenantId}, #{userRoleRelationDO.userId},
                #{userRoleRelationDO.roleId}, #{userRoleRelationDO.status})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_user_role_relation WHERE id = #{id}
    </select>

    <select id="selectByTenantAndUser" resultMap="BaseResultMap">
        SELECT * FROM t_user_role_relation WHERE tenant_id = #{tenantId} AND user_id = #{userId}
    </select>

    <update id="update">
        UPDATE t_user_role_relation SET status = #{userRoleRelationDO.status} WHERE id = #{userRoleRelationDO.id}
    </update>

    <delete id="delete">
        DELETE FROM t_user_role_relation WHERE id = #{id}
    </delete>
</mapper>