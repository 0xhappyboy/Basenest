<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basenest.core.dao.mapper.system.SystemUserPermissionMapper">

    <resultMap id="BaseResultMap" type="com.basenest.core.dao.dos.system.SystemUserPermissionDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="permission_code" property="permissionCode" jdbcType="VARCHAR"/>
        <result column="grant_type" property="grantType" jdbcType="TINYINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="systemUserPermissionDO.id">
        INSERT INTO t_sys_user_permissions (user_id, permission_code, grant_type, status)
        VALUES (#{systemUserPermissionDO.userId},
                #{systemUserPermissionDO.permissionCode},
                #{systemUserPermissionDO.grantType},
                #{systemUserPermissionDO.status})
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM t_sys_user_permissions WHERE user_id = #{userId} AND status = 1
    </select>

    <select id="selectByPermissionCode" resultMap="BaseResultMap">
        SELECT * FROM t_sys_user_permissions WHERE permission_code = #{permissionCode} AND status = 1
    </select>

    <delete id="deleteByUserId">
        DELETE FROM t_sys_user_permissions WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByUserIdAndCode">
        DELETE FROM t_sys_user_permissions
        WHERE user_id = #{userId} AND permission_code = #{permissionCode}
    </delete>
</mapper>