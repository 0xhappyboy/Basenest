<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basenest.core.dao.mapper.system.SystemRolePermissionMapper">

    <resultMap id="BaseResultMap" type="com.basenest.core.dao.dos.system.SystemRolePermissionDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="permission_code" property="permissionCode" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="systemRolePermissionDO.id">
        INSERT INTO t_sys_role_permissions (role_id, permission_code, status)
        VALUES (#{systemRolePermissionDO.roleId},
                #{systemRolePermissionDO.permissionCode},
                #{systemRolePermissionDO.status})
    </insert>

    <select id="selectByRoleId" resultMap="BaseResultMap">
        SELECT * FROM t_sys_role_permissions WHERE role_id = #{roleId} AND status = 1
    </select>

    <select id="selectByPermissionCode" resultMap="BaseResultMap">
        SELECT * FROM t_sys_role_permissions WHERE permission_code = #{permissionCode} AND status = 1
    </select>

    <delete id="deleteByRoleId">
        DELETE FROM t_sys_role_permissions WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteByRoleIdAndCode">
        DELETE FROM t_sys_role_permissions
        WHERE role_id = #{roleId} AND permission_code = #{permissionCode}
    </delete>
</mapper>